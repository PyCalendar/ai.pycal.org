msgstr "Se añadió %(repository)s; se comprobaron %(count)d pull requests abiertas."

#, python-format
msgid "%s is no longer checked."
msgstr "%s ya no se comprueba."

#, python-format
msgid "You updated this project recently. You can update it again in %(minutes)d minutes."
msgstr "Actualizaste este proyecto hace poco. Puedes actualizarlo de nuevo en %(minutes)d minutos."

#, python-format
msgid "The configuration was read again; %(count)d open pull requests were checked."
msgstr "Se leyó de nuevo la configuración; se comprobaron %(count)d pull requests abiertas."
