# Local test setup: copy this file to .env, then fill in the GitHub App values.
# make run and make app-manifest both load .env automatically.
# Restart make run after editing .env. Keep real credentials out of version control.

# Choose a unique app name before generating the manifest.
SITE_NAME=
# Empty values use localhost with PORT=5000 and DOCS_PORT=8000 by default.
SITE_URL=
DOCS_URL=

# Set these values from your development GitHub App.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=data/github-app.pem

# Required for signing in: an OAuth app with the callback URL
# <SITE_URL>/accounts/github/login/callback/ (docs/how-to/github-app-site.rst#oauth-app).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_SECRET=

# make run supplies DEBUG=1, allowed hosts and CSRF origins when unset.
# The secret key and SQLite database are created in data/ automatically.
# Start the documentation in a second terminal with make livehtml.
