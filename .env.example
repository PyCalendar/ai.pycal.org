## Copy to .env and change what you need. All settings:
## For a local test setup, start with .env.development.example instead.
## https://ai-pycal-org.readthedocs.io/en/latest/reference/settings.html
## Remove the # in front of a setting to use it.
## make run and make app-manifest supply localhost development defaults for
## unset values; values configured here or in the shell take precedence.

######## The site ########
# SITE_NAME=ai.pycal.org
# SITE_URL=https://ai.pycal.org
# ALLOWED_HOSTS=ai.pycal.org
# CSRF_TRUSTED_ORIGINS=https://ai.pycal.org
## GitHub handles that may open the admin pages, comma separated
# SITE_ADMINS=
## Generated into ./data if empty
# SECRET_KEY=
# DATABASE_URL=postgres://agreements:agreements@db/agreements

######## The GitHub App ########
## https://ai-pycal-org.readthedocs.io/en/latest/how-to/github-app.html
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_SECRET=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_PRIVATE_KEY_FILE=/app/data/github-app.pem
## The names of the checks of the pull requests: <STATUS_CONTEXT>/<agreement>
# STATUS_CONTEXT=ai.pycal.org

######## Signing ########
# SIGN_MIN_SECONDS=3
# SIGN_MAX_HOURS=24

######## Colors and icon ########
## https://ai-pycal-org.readthedocs.io/en/latest/how-to/brand.html
# COLOR_PRIMARY=#2b5b84
# COLOR_ACCENT=#ffd43b
# COLOR_NAV=#1e3f5c
# COLOR_DARK_PRIMARY=#8fbbe0
# EXTRA_CSS_URL=
# FAVICON_FILE=/app/data/favicon.png

######## Mail: the emails about new permissions ########
## Without EMAIL_HOST, the emails are written to the log.
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=agreements@ai.pycal.org

######## Server ########
# WORKERS=2
# THREADS=4
