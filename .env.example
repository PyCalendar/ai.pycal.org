## The settings of a deployed site. Copy to .env, then fill in or change what you need.
## Remove the # in front of a setting to use it. A setting with # keeps its default.
## The most important come first. All settings, explained:
## https://ai-pycal-org.readthedocs.io/en/latest/reference/settings.html
##
## For a local test setup, start with .env.development.example instead:
## make run and make app-manifest supply localhost defaults for unset values;
## values configured here or in the shell take precedence.

######## 1. The address of the site (required) ########
## https://ai-pycal-org.readthedocs.io/en/latest/reference/settings.html#settings-address
## The address people and GitHub use, without / at the end. The checks of the pull
## requests, the emails and the GitHub App link to it.
SITE_URL=https://ai.pycal.org
## The host names of the site, comma separated; other hosts are refused.
## The health check of the container sends the first one.
ALLOWED_HOSTS=ai.pycal.org
## The address with https://; forms sent from other origins are refused.
CSRF_TRUSTED_ORIGINS=https://ai.pycal.org

######## 2. The GitHub App (required) ########
## https://ai-pycal-org.readthedocs.io/en/latest/reference/settings.html#settings-github-app
## Create the app first: https://ai-pycal-org.readthedocs.io/en/latest/how-to/github-app.html
## The numeric id of the app, on its settings page.
GITHUB_APP_ID=
## The name of the app in https://github.com/apps/<slug>, for the Setup page.
GITHUB_APP_SLUG=
## Client id and client secret: for signing in with GitHub.
GITHUB_CLIENT_ID=
GITHUB_SECRET=
## The secret of the webhooks; without it all webhooks are refused.
GITHUB_WEBHOOK_SECRET=
## The private key of the app, as file in the volume of the data ...
GITHUB_APP_PRIVATE_KEY_FILE=/app/data/github-app.pem
## ... or the key itself, with \n for the line breaks.
# GITHUB_APP_PRIVATE_KEY=
## Only for GitHub Enterprise Server.
# GITHUB_API=https://api.github.com

######## 3. Data and secrets ########
## https://ai-pycal-org.readthedocs.io/en/latest/reference/settings.html#settings-data
## The directory of the SQLite database and the generated secret key: back it up.
# DATA_DIR=/app/data
## Generated once into DATA_DIR if empty. Changing it signs everybody out.
# SECRET_KEY=
## PostgreSQL instead of SQLite in DATA_DIR.
# DATABASE_URL=postgres://agreements:agreements@db/agreements

######## 4. Email ########
## https://ai-pycal-org.readthedocs.io/en/latest/reference/settings.html#settings-email
## Emails to administrators about new permissions and problems of their projects.
## Without EMAIL_HOST, the emails are written to the log.
# EMAIL_HOST=smtp.example.org
## 587 uses STARTTLS, 465 uses SSL (EMAIL_USE_TLS / EMAIL_USE_SSL to choose yourself).
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
## The sender; default agreements@<SITE_NAME>.
# DEFAULT_FROM_EMAIL=agreements@ai.pycal.org

######## 5. People ########
## https://ai-pycal-org.readthedocs.io/en/latest/reference/settings.html#settings-people
## GitHub handles, comma separated, that may open the admin pages.
# SITE_ADMINS=

######## 6. Name, look and links ########
## https://ai-pycal-org.readthedocs.io/en/latest/reference/settings.html#settings-look
## The name in the menu, the titles and the emails.
# SITE_NAME=ai.pycal.org
## The names of the checks of the pull requests: <STATUS_CONTEXT>/<agreement>.
## Changing it creates new checks; update the required checks of branch protection.
# STATUS_CONTEXT=ai.pycal.org
## Extra links of the footer and the About page: Title=URL, comma separated; empty for none.
# FOOTER_LINKS=pycal.org=https://pycal.org
## The time zone of the times on the pages, such as the build on the About page.
# TIME_ZONE=Europe/Berlin
## The code and the documentation, for the links of the pages, errors and emails.
# SOURCE_URL=https://github.com/PyCalendar/ai.pycal.org
# DOCS_URL=https://ai-pycal-org.readthedocs.io/en/latest/
## Colors of the light and dark pages; all names:
## https://ai-pycal-org.readthedocs.io/en/latest/how-to/brand.html
# COLOR_PRIMARY=#2b5b84
# COLOR_ACCENT=#ffd43b
# COLOR_NAV=#1e3f5c
# COLOR_DARK_PRIMARY=#8fbbe0
## A style sheet loaded after that of the site.
# EXTRA_CSS_URL=
## A PNG, ICO or SVG file for the icon, in the volume of the data.
# FAVICON_FILE=/app/data/favicon.png

######## 7. Signing ########
## https://ai-pycal-org.readthedocs.io/en/latest/reference/settings.html#settings-signing
## Seconds between showing an agreement and signing it, at least.
# SIGN_MIN_SECONDS=3
## Hours in which a shown agreement can be signed.
# SIGN_MAX_HOURS=24

######## 8. The server ########
## https://ai-pycal-org.readthedocs.io/en/latest/reference/settings.html#settings-server
## The port in the container, gunicorn processes and threads of each.
# PORT=5000
# WORKERS=2
# THREADS=4
## DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO
## Details of failures in the pages: for development only, never on a public site.
# DEBUG=false
